# Copy to .env to override. Demo-safe defaults are built into docker-compose.yml.
# Passwords are only read when the postgres volume is first created (see data/postgres/init/01-schemas.sh).
POSTGRES_PASSWORD=postgres_demo
ESTIMATOR_DB_PASSWORD=estimator_demo
MARKET_DB_PASSWORD=market_demo

# Host ports, also used inside the containers and for service-to-service URLs.
ML_API_PORT=8000
ESTIMATOR_API_PORT=8001
MARKET_API_PORT=8080
WEB_PORT=3000
